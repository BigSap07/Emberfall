# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Packages/packages-lock.json IS tracked, deliberately. It was ignored here as "machine
# specific"; it is not. It is the RESOLVED version set - the transitive packages
# manifest.json never names, and the commit a git-URL dependency resolved to.
# com.coplaydev.unity-mcp is pinned to #main, so without the lock two clones can be
# running different engines.

# IDE
.vs/
.idea/
*.csproj
*.sln
*.user

# Offline tooling output
/Tools/DevHarness/bin/
/Tools/**/*.rsp

# Unity AI generation history (raw model output + metadata, keyed by asset GUID)
/GeneratedAssets/

# Working reference reports, not design docs
/Reports/

# OS
Thumbs.db
.DS_Store

# Raw animation source sheets, staged for Tools/import-sprite-sheets.ps1.
# Hundreds of MB of PNGs whose PROCESSED output already lives in
# Assets/Resources/Sprites/Units and is tracked. Committing the sources too would
# double that in history permanently, and git cannot forget a blob later.
# feat/sprite-sheet-player holds the only copy of Kael's set - keep that branch.
/Assets/_Incoming/

ProjectSettings/Packages/

Assets/_Incoming.meta
Tools/Screenshots/
.claude/
Captures/
Tools/converted_heroes.json

# Dev Arena capture output - evidence for a branch, not an asset.
Tools/DevArenaShots/
