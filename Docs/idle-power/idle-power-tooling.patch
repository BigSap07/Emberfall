diff --git a/Tools/DevHarness/R24IdlePowerStudy.cs b/Tools/DevHarness/R24IdlePowerStudy.cs
new file mode 100644
index 0000000..35334e2
--- /dev/null
+++ b/Tools/DevHarness/R24IdlePowerStudy.cs
@@ -0,0 +1,210 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using Emberfall.Core.Cloud;
+using Emberfall.Core.Data;
+using Emberfall.Core.Model;
+using Emberfall.Core.Progression;
+using Emberfall.Core.Session;
+
+namespace Emberfall.DevHarness
+{
+    /// <summary>
+    /// THE IDLE POWER STUDY (Docs/IDLE-POWER-OPTIONS.md). Measurement only, never committed to Tools/: it lives in
+    /// Docs/idle-power/idle-power-tooling.patch. Three ways for idle time to become power past the level caps, each
+    /// simulated on the R16 reference walk through the R24 whale column (--whale-curve ... --whale-loop):
+    ///   --idle-opt 1  Training: Gold buys account ranks per guild tech family (GuildTech.ApplyShare's split);
+    ///                 rank r of a family costs trainCost * trainGrowth^r Gold and the family's heroes carry
+    ///                 (1 + trainShare)^r - 1 of their power on the family's rung stats.
+    ///   --idle-opt 2  Soft cap: a hero at its cap keeps levelling, at overcapPremium times the level curve's price.
+    ///   --idle-opt 3  Essence: an idle-only material (the frontier's idle Gold per hour / essenceDivisor, claimed with
+    ///                 idle and capped like it; never sold) buys the same family ranks as option 1, at
+    ///                 essenceCost * trainGrowth^r Essence.
+    ///   --enemy-scale FILE  one multiplier per stage index (the content re-solved to the new curve, by proxy):
+    ///                 every enemy's HP, Attack and Defense at that stage are multiplied by it, or with
+    ///                 --idle-p enemyByLevel=1 every enemy stands at the Level that gives that multiple.
+    /// Every purchase here is a fixed price for a fixed effect. Nothing rolls.
+    /// </summary>
+    internal static partial class Program
+    {
+        private static int _idleOpt;
+        private static readonly Dictionary<string, double> _idleP = new Dictionary<string, double>();
+        private static double[] _idleEnemyScale;
+        private static readonly Dictionary<string, int> _trainRanks = new Dictionary<string, int>();
+        private static ContentDatabase _idleDb;
+        private static long _essence;
+
+        private static double IdleP(string name, double fallback)
+        {
+            double v;
+            return _idleP.TryGetValue(name, out v) ? v : fallback;
+        }
+
+        private static bool IdleTakeArg(string[] args, ref int i)
+        {
+            string a = args[i];
+            if (a == "--idle-opt" && i + 1 < args.Length) { _idleOpt = int.Parse(args[++i]); return true; }
+            if (a == "--idle-p" && i + 1 < args.Length)
+            {
+                string[] kv = args[++i].Split('=');
+                _idleP[kv[0]] = double.Parse(kv[1], CultureInfo.InvariantCulture);
+                return true;
+            }
+            if (a == "--enemy-scale" && i + 1 < args.Length)
+            {
+                string[] lines = File.ReadAllLines(args[++i]);
+                List<double> xs = new List<double>();
+                foreach (string l in lines) if (l.Trim().Length > 0) xs.Add(double.Parse(l.Trim(), CultureInfo.InvariantCulture));
+                _idleEnemyScale = xs.ToArray();
+                return true;
+            }
+            return false;
+        }
+
+        private static string IdleHeader()
+        {
+            string s = "# idle-opt " + _idleOpt;
+            foreach (KeyValuePair<string, double> kv in _idleP) s += " " + kv.Key + "=" + kv.Value.ToString(CultureInfo.InvariantCulture);
+            s += _idleEnemyScale != null ? " enemy-scale on" : " enemy-scale off";
+            return s + "\n";
+        }
+
+        private static void IdleBeginWalk(ContentDatabase db)
+        {
+            _idleDb = db;
+            _trainRanks.Clear();
+            _essence = 0;
+            StatMath.StudyHeroHook = _idleOpt == 1 || _idleOpt == 3 ? (Action<UnitStats, HeroDef>)TrainingApply : null;
+            StatMath.StudyEnemyScale = 0f;
+            StatMath.StudyEnemyByLevel = IdleP("enemyByLevel", 0) > 0;
+        }
+
+        private static void IdleEndWalk()
+        {
+            StatMath.StudyHeroHook = null;
+            StatMath.StudyEnemyScale = 0f;
+        }
+
+        /// <summary>The enemy multiplier for a stage index; 0 (off) when no scale file was given.</summary>
+        private static void IdleSetEnemyStage(int stageIdx)
+        {
+            if (_idleEnemyScale == null || stageIdx < 0) { StatMath.StudyEnemyScale = 0f; return; }
+            StatMath.StudyEnemyScale = (float)_idleEnemyScale[Math.Min(stageIdx, _idleEnemyScale.Length - 1)];
+        }
+
+        private static bool IdleOpen(ContentDatabase db, PlayerProfile p)
+        {
+            // every option opens where the caps start to bind: the chapter 1 finale cleared (the talents and armor row)
+            return FeatureGate.IsUnlocked(db, p, Feature.Talents);
+        }
+
+        // ------------------------------------------------------------------ option 1: Training (Gold)
+
+        private static void TrainingApply(UnitStats stats, HeroDef def)
+        {
+            if (_idleDb == null || _idleDb.GuildTech == null || def == null) return;
+            GuildTechFamilyDef family = _idleDb.GuildTech.FamilyOfRole(def.Role);
+            if (family == null) return;
+            int r;
+            if (!_trainRanks.TryGetValue(family.Id, out r) || r <= 0) return;
+            double share = Math.Pow(1.0 + IdleP("trainShare", 0.05), r) - 1.0;
+            GuildTech.ApplyShare(stats, family, (float)share);
+        }
+
+        private static long TrainingCost(int rank)
+        {
+            double first = _idleOpt == 3 ? IdleP("essenceCost", 200) : IdleP("trainCost", 20000);
+            return (long)Math.Round(first * Math.Pow(IdleP("trainGrowth", 1.10), rank));
+        }
+
+        private static void TrainingSpend(ContentDatabase db, GameSession s)
+        {
+            PlayerProfile p = s.Profile;
+            if (db.GuildTech == null || !IdleOpen(db, p)) return;
+            for (int guard = 0; guard < 2000; guard++)
+            {
+                string cheapest = null;
+                long cost = long.MaxValue;
+                foreach (HeroInstance h in p.TeamHeroes())
+                {
+                    if (h.Def == null) continue;
+                    GuildTechFamilyDef f = db.GuildTech.FamilyOfRole(h.Def.Role);
+                    if (f == null) continue;
+                    int r;
+                    _trainRanks.TryGetValue(f.Id, out r);
+                    long c = TrainingCost(r);
+                    if (c < cost || (c == cost && string.CompareOrdinal(f.Id, cheapest) < 0)) { cost = c; cheapest = f.Id; }
+                }
+                if (cheapest == null) return;
+                if (_idleOpt == 3) { if (_essence < cost) return; _essence -= cost; }
+                else if (!IdleSpendGold(p, cost)) return;
+                int have;
+                _trainRanks.TryGetValue(cheapest, out have);
+                _trainRanks[cheapest] = have + 1;
+            }
+        }
+
+        /// <summary>freeGoldOnly=1: the sink takes earned Gold only and refuses Sealed (bought) Gold, as the
+        /// Quartermaster does. Otherwise it is a deterministic sink and takes Sealed Gold first, as a level-up does.</summary>
+        private static bool IdleSpendGold(PlayerProfile p, long cost)
+        {
+            if (IdleP("freeGoldOnly", 0) > 0)
+            {
+                if (p.FreeGold < cost) return false;
+                p.Gold -= cost;
+                return true;
+            }
+            if (p.Gold < cost) return false;
+            p.SpendGoldDeterministic(cost);
+            return true;
+        }
+
+        // ------------------------------------------------------------------ option 2: soft cap (Gold)
+
+        private static long OvercapCost(GameSession s, HeroInstance h)
+        {
+            BalanceConfig b = s.Balance;
+            double baseCost = b.LevelCostA + b.LevelCostB * (double)h.Level + b.LevelCostC * (double)h.Level * h.Level;
+            return (long)Math.Round(baseCost * IdleP("overcapPremium", 2.0));
+        }
+
+        private static void OvercapSpend(ContentDatabase db, GameSession s)
+        {
+            PlayerProfile p = s.Profile;
+            if (!IdleOpen(db, p)) return;
+            for (int guard = 0; guard < 5000; guard++)
+            {
+                HeroInstance best = null;
+                long cost = long.MaxValue;
+                foreach (HeroInstance h in p.TeamHeroes())
+                {
+                    if (h.Def == null || h.Level < s.HeroLevelCapOf(h)) continue;   // below the cap the walk's own SpendGold buys
+                    long c = OvercapCost(s, h);
+                    if (c < cost) { cost = c; best = h; }
+                }
+                if (best == null || !IdleSpendGold(p, cost)) return;
+                best.Level += 1;
+            }
+        }
+
+        // ------------------------------------------------------------------ option 3: idle Essence
+
+        private static void IdleDustClaim(ContentDatabase db, GameSession s, long seconds)
+        {
+            if (_idleOpt != 3) return;
+            if (!IdleOpen(db, s.Profile)) return;
+            StageDef frontier = s.FurthestClearedStage;
+            if (frontier == null) return;
+            double hours = Math.Min(seconds / 3600.0, s.Balance.IdleCapHours);
+            _essence += (long)Math.Floor(frontier.IdleGoldPerHour / IdleP("essenceDivisor", 100) * hours);
+        }
+
+        /// <summary>Called by the walk after its own level spending, every sitting.</summary>
+        private static void IdleAfterGold(ContentDatabase db, GameSession s)
+        {
+            if (_idleOpt == 1 || _idleOpt == 3) TrainingSpend(db, s);
+            else if (_idleOpt == 2) OvercapSpend(db, s);
+        }
+    }
+}
