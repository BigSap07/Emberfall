{
  // Every tuning number the prototype reads. Edit here, no recompile needed.
  "defenseConstant": 400,
  "defensePerLevel": 24,

  "energyMax": 100,
  "energyPerBasicAttack": 28,
  "energyOnDamaged": 9,
  "maxRounds": 30,
  "damageVariance": 0.06,
  "speedVariance": 0.08,
  // gates both player deploys and enemy spawns; keep equal to PlayerProfile.TeamSize
  "maxTeamSize": 5,
  // relic slots on one hero; more than one stacks rule changes into a build, and a team-wide slot
  // would be an aura, which is a global multiplier. DESIGN-RELICS' relicEnergyBankMax is absent on
  // purpose: it bounded the Tidewrought Metronome's carry, and that relic is cut.
  "relicSlotsPerHero": 1,
  // Fraction of a hit that Mirrored Wound returns to the attacker. The relic's RULE text says
  // "part of that damage returns" and never a number - a mythic relic's Rule contains none, even
  // though (unlike when this relic shipped) a mythic relic's stat block now can - so the magnitude
  // lives here. Placeholder; task 13's retune owns it.
  "mirroredWoundReflectFraction": 0.25,

  // hero level up cost = A + B*level + C*level^2
  //
  // RETUNED by the economy-curve pass, from 55 + 26L + 3.2L^2. The quadratic term is gone on
  // purpose and the reason is arithmetic rather than taste. A hero's power is LINEAR in level -
  // StatMath.Build is 1 + growth * (level - 1) - so with a quadratic cost the gold needed to hold
  // a given power ratio grows as the CUBE of the level, while no income curve in an idle game
  // grows anything like that fast. The old curve is why the simulated player's power ratio fell
  // from x3.2 at 2-1 to x1.55 at 2-12: they were falling further behind the content every stage
  // and the cost curve, not the income, was doing it. A linear cost makes level track gold
  // directly, which is what lets the idle rate be the lever it is supposed to be.
  //
  // The constant is large because that is the other half of the same problem. The first level now
  // costs 1,070 gold against a 400 starting purse, and the thirty-fifth costs 17,050; a hero from
  // 1 to the level-80 hard cap costs about 1,533,000, against about 622,000 before. A player ends
  // the campaign around level 30 rather than level 58, and that is the point: at level 58 the
  // pinned five-body line was between 1.55 and 3.2 times every stage's recommendedPower and
  // cleared all 24 ceilings at 100%.
  "levelCostA": 600,
  "levelCostB": 470,
  "levelCostC": 0,
  "heroLevelCapBase": 12,
  "heroLevelCapPerPlayerLevel": 4,
  "heroLevelHardCap": 80,

  // account xp needed for the next rank = base * level^exponent
  "playerXpBase": 120,
  "playerXpExponent": 1.35,

  // floor rate for a fresh account with zero stages cleared; per-stage rates live in campaign.json
  "idleGoldPerHourFloor": 140,
  "idleShardsPerHourFloor": 7,
  "idleCapHours": 10,

  // Replay economy - see DESIGN-REPLAY-ECONOMY.md. Repeat clears of an already-cleared stage that
  // still pay the full purse, counted per stage per UTC day. Past the allowance the fight still
  // runs, still counts as a win and still teaches, but pays repeatRewardFloor of the purse.
  "repeatFullClearsPerDay": 3,
  // Has to be 0. A 25% floor still leaves ~19,200 gold/hour at 240 clears an hour, 15x the idle
  // cache; only zero actually bites. A player's FIRST clear of a stage is never capped.
  "repeatRewardFloor": 0.0,
  // Hour of the UTC day the per-stage counters roll over.
  "dailyResetHourUtc": 4,

  // Relic Dust - see DESIGN-RELIC-PROGRESSION section 1. Paid off the repeat-clear loop above,
  // never off a first clear (first-clear rewards are already tuned and adding to them would mean
  // rebalancing them), and scaled by stage difficulty as base + perStageIndex * stage.globalIndex.
  // PLACEHOLDER SOURCE, and no longer the only one: The Deep Recital (DESIGN-DEEP-RECITAL.md) is
  // now built and grants Relic Dust of its own at milestone floors (recitalMilestoneDustPerTier
  // below), but repeat-clears remain live and untouched - the Recital is a second source, not a
  // replacement, and a fresh account still needs the campaign's drip before it can reach deep
  // Recital floors at all. Both numbers below are still a balance pass, per the doc deferring the
  // curve exactly the way DESIGN-BUILD-ORDER task 14 defers recommendedPower.
  "relicDustPerRepeatClear": 6,
  "relicDustPerStageIndex": 2,
  // Highest tier a relic can be owned at. 1 until the balance pass authors tier 2 - the tier field
  // and its save path exist now so that pass is a content and tuning change, not a save migration.
  // Nothing in the simulation reads tier, so a tier-2 relic would behave exactly like a tier-1 one.
  "relicMaxTier": 1,
  // Relic Dust cost to purchase one LEGENDARY-grade (stat-only) relic from the shop.
  "relicShopPrice": 80,
  // Relic Dust cost to purchase one MYTHIC-grade relic. Deliberately steep and Dust-only, no
  // second currency: at relicDustPerRepeatClear/relicDustPerStageIndex's current rates, a player
  // repeat-clearing their single highest-Dust stage 3x/day (the repeat cap) earns roughly
  // 84/day mid-campaign (globalIndex ~11) to 156/day at the final stage (globalIndex 23). 2400
  // Dust is about 3-4 weeks of that mid-campaign, 2-3 weeks at the endgame rate, and roughly a
  // week even for an unusually dedicated player farming several of their highest stages per day.
  // Steep on purpose so Mythic reads as a long goal, not a purchase. Balance pass placeholder,
  // same as every other relic number here - expect this to move.
  "relicMythicShopPrice": 2400,

  "summonCost": 120,
  "summonWeight1": 0,
  "summonWeight2": 0,
  "summonWeight3": 0,
  "summonWeight4": 0,
  "summonWeight5": 100,
  // 450 before the economy-curve pass. A duplicate's gold refund was the second largest gold
  // channel in the whole economy - 13% of everything earned by 2-1 and 18% by 2-12, measured by
  // the POWER SOURCES instrument - and it is the only large one whose size nobody chose: it
  // rides the shard rate, and the shard rate is tuned for how fast the roster fills. That made a
  // sixth of the campaign's gold immune to the idle curve that the rest of it is shaped by.
  "duplicateGold": 150,
  "duplicateShards": 30,

  "startingGold": 400,
  "startingShards": 120,

  // The Deep Recital - endless floor ladder. First-pass placeholders throughout; see
  // Definitions.cs BalanceConfig for the reasoning behind each and the unreconciled conflicts
  // with DESIGN-DEEP-RECITAL.md this shape carries.
  "recitalBaseLevel": 20,
  "recitalLevelsPerFloor": 2,
  "recitalBonusLevelsPerCycle": 3,
  "recitalEchoesMax": 5,
  "recitalEchoesRechargeHours": 4,

  // ---- The Proving (PvP). Every value here is ILLUSTRATIVE, per DESIGN-PVP sections 5, 6 and 9 -
  // starting points chosen so the mode runs, not tuning. The balance pass that firms them up needs
  // the mode playable to have anything to measure. Nothing here touches campaign.json or any key
  // task 13 retuned.
  "provingBrandsMax": 5,
  "provingBrandsRechargeHours": 3,
  "provingRewardValorBase": 30,
  "provingRewardValorPerStanding": 2,
  "provingLossRewardFraction": 0.25,
  "provingStandingPerWin": 3,
  "provingStandingPerLoss": 2,
  "provingGhostBootstrapCount": 3,  "recitalRewardGoldBase": 200,
  "recitalRewardGoldPerFloor": 20,
  "recitalRewardShardsBase": 10,
  "recitalRewardShardsPerFloor": 1,
  "recitalMilestoneInterval": 10,
  "recitalMilestoneDustPerTier": 150,
  "recitalDeepMilestoneInterval": 50,
  "recitalDeepMilestoneDustFallback": 1000,

  // Guardians: boss-plus-escorts encounter on every Nth Recital floor.
  "recitalGuardianInterval": 10,
  "recitalGuardianBossLevelBonus": 5,

  // Coda: The Deep Recital's own currency. No sink yet - purse, accrual and save field only.
  "recitalCodaBase": 5,
  "recitalCodaPerFloor": 1,
  "recitalCodaGuardianBase": 25,
  "recitalCodaGuardianPerFloor": 3
}
