{
  // Every tuning number the prototype reads. Edit here, no recompile needed.
  "defenseConstant": 400,
  "defensePerLevel": 24,

  "energyMax": 100,
  "energyPerBasicAttack": 28,
  "energyOnDamaged": 9,
  "maxRounds": 30,
  "damageVariance": 0.06,
  "speedVariance": 0.08,
  // gates both player deploys and enemy spawns; keep equal to PlayerProfile.TeamSize
  "maxTeamSize": 5,
  // cap on Gale kill re-entry turns per round; the mechanic (task 11) must read this
  "galeExtraTurnsPerRound": 1,
  // most simultaneous Burn entries one unit can carry from Ember stacking; at the cap a further
  // application refreshes an existing entry instead of adding a new one
  "emberBurnStackCap": 3,
  // relic slots on one hero; more than one stacks rule changes into a build, and a team-wide slot
  // would be an aura, which is a global multiplier. DESIGN-RELICS' relicEnergyBankMax is absent on
  // purpose: it bounded the Tidewrought Metronome's carry, and that relic is cut.
  "relicSlotsPerHero": 1,

  // hero level up cost = A + B*level + C*level^2
  "levelCostA": 55,
  "levelCostB": 26,
  "levelCostC": 3.2,
  "heroLevelCapBase": 12,
  "heroLevelCapPerPlayerLevel": 4,
  "heroLevelHardCap": 80,

  // account xp needed for the next rank = base * level^exponent
  "playerXpBase": 120,
  "playerXpExponent": 1.35,

  // floor rate for a fresh account with zero stages cleared; per-stage rates live in campaign.json
  "idleGoldPerHourFloor": 140,
  "idleShardsPerHourFloor": 7,
  "idleCapHours": 10,

  // Replay economy - see DESIGN-REPLAY-ECONOMY.md. Repeat clears of an already-cleared stage that
  // still pay the full purse, counted per stage per UTC day. Past the allowance the fight still
  // runs, still counts as a win and still teaches, but pays repeatRewardFloor of the purse.
  "repeatFullClearsPerDay": 3,
  // Has to be 0. A 25% floor still leaves ~19,200 gold/hour at 240 clears an hour, 15x the idle
  // cache; only zero actually bites. A player's FIRST clear of a stage is never capped.
  "repeatRewardFloor": 0.0,
  // Hour of the UTC day the per-stage counters roll over.
  "dailyResetHourUtc": 4,

  // Relic Dust - see DESIGN-RELIC-PROGRESSION section 1. Paid off the repeat-clear loop above,
  // never off a first clear (first-clear rewards are already tuned and adding to them would mean
  // rebalancing them), and scaled by stage difficulty as base + perStageIndex * stage.globalIndex.
  // PLACEHOLDER SOURCE: the intended long-term home for Relic Dust is harder, dedicated content -
  // the endless mode proposed as The Deep Recital in DESIGN-DEEP-RECITAL.md, which is not built.
  // Repeat-clears are a bootstrap so the currency and the shop have somewhere to come from in the
  // meantime, not the final design. Both numbers are a balance pass, per the doc deferring the
  // curve exactly the way DESIGN-BUILD-ORDER task 14 defers recommendedPower.
  "relicDustPerRepeatClear": 6,
  "relicDustPerStageIndex": 2,
  // Highest tier a relic can be owned at. 1 until the balance pass authors tier 2 - the tier field
  // and its save path exist now so that pass is a content and tuning change, not a save migration.
  // Nothing in the simulation reads tier, so a tier-2 relic would behave exactly like a tier-1 one.
  "relicMaxTier": 1,
  // Relic Dust cost to purchase one relic from the shop. Balance pass placeholder.
  "relicShopPrice": 80,

  "summonCost": 120,
  "summonWeight1": 0,
  "summonWeight2": 0,
  "summonWeight3": 0,
  "summonWeight4": 0,
  "summonWeight5": 100,
  "duplicateGold": 450,
  "duplicateShards": 30,

  "startingGold": 400,
  "startingShards": 120
}
